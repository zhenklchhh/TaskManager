# Copy to .env.prod and fill in real values

CONFIG_PATH=config/prod.yaml

# PostgreSQL
POSTGRES_DB=taskmanager
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgres://taskuser:change_me_strong_password@postgres:5432/taskmanager?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_64_char_secret

# Your domain (no trailing slash)
APP_URL=https://yourdomain.com

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail (optional — keep mailhog for demo, or use real SMTP)
MAIL_HOST=mailhog
